# Where the live Ceylo backend lives. Used by the Next.js rewrite that proxies
# /cylo-api/* so the browser never makes a cross-origin call.
CYLO_API_ORIGIN=https://ceylo-backend.onrender.com/api/v1
# CYLO_API_ORIGIN=http://localhost:3002/api/v1

# Optional: call the API directly instead of through the proxy. That backend
# must then allow this origin via CORS.
# NEXT_PUBLIC_API_BASE_URL=https://ceylo-backend.onrender.com/api/v1

# Optional: if your backend accepts a fixed development code, put it here and
# the sign-in screen will show it as a hint. Leave unset in any shared or
# deployed build — it is a working credential, not documentation.
# NEXT_PUBLIC_DEV_OTP=
