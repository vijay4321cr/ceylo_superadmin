# The API base URL is NOT configurable — it is fixed in src/lib/api/client.ts
# so every environment calls the same backend.
#
# Optional: if your backend accepts a fixed development code, put it here and
# the sign-in screen shows it as a hint. Leave unset in any shared or deployed
# build — it is a working credential, not documentation.
# NEXT_PUBLIC_DEV_OTP=
